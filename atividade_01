<?php

function analisarSenha($senha)
{
   $maiusculas = contarLetrasMaiusculas($senha);
   $minusculas = contarLetrasMinusculas($senha);
   $numeros = contarNumeros($senha);
   $especiais = caracterEspecial($senha); 
   $tamanho = strlen($senha);
   $nivelSeguranca = classificarSenha($senha);

    return[
        'maiusculas' => $maiusculas,
        'minusculas' => $minusculas,
        'numeros' => $numeros,
        'Caracteres especiais' => $especiais,
        'Tamanho da senha' => $tamanho,
        'Nivel de segurança' => $nivelSeguranca,
    ];
}

function contarLetrasMaiusculas($senha)
{
$contador = 0;
$letras = str_split($senha);
foreach ($letras as $letra) {
    if(ctype_upper($letra)) {
        $contador++;
    }  
}
return $contador;
}
function contarLetrasMinusculas($senha)
{
    $contador = 0;
    $letras = str_split($senha);
    foreach ($letras as $letra){
        if(ctype_lower($letra)){
            $contador++;
        }
    }
    return $contador;
}
function contarNumeros($senha)
{
    $contador = 0;
    $numeros = str_split($senha);
    foreach ($numeros as $numero){
        if (ctype_digit($numero)){
            $contador ++;
        }
    }
    return $contador;
}
function caracterEspecial($senha)
{
    $contador = 0; 
    $caracteresEspeciais = str_split($senha);
    foreach ($caracteresEspeciais as $caracterEspecial){
     if (!ctype_upper($caracterEspecial) && !ctype_lower($caracterEspecial) && !ctype_digit($caracterEspecial)) {
        $contador++;
     }
    }
    return $contador;
}
function classificarSenha($senha)
{
    $temMaiuscula = contarLetrasMaiusculas($senha) > 0;
    $temMinuscula = contarLetrasMinusculas($senha) > 0;
    $temNumero = contarNumeros($senha) > 0;
    $temEspecial = caracterEspecial($senha) > 0;
    $temTamanhoMinimo = strlen($senha) >= 8;

    $pontuacao = $temMaiuscula + $temMinuscula + $temNumero + $temEspecial + $temTamanhoMinimo;

    if ($pontuacao == 5) {
    return "Muito Forte";
} elseif ($pontuacao == 4) {
    return "Forte";
} elseif ($pontuacao >= 2) {
    return "Média";
} else {
    return "Fraca";
}
}

